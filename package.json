{
  "name": "@noor-mkdad/iso20022-parser-client",
  "version": "1.0.0",
  "description": "Official zero-dependency, high-speed JavaScript/TypeScript client for ISO 20022 Financial Message Parser & Validator",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "keywords": [
    "iso-20022",
    "swift",
    "pacs-008",
    "camt-053",
    "pain-001",
    "sepa-xml",
    "fednow",
    "financial-messaging",
    "banking"
  ],
  "author": "Noor Mkdad",
  "license": "MIT",
  "homepage": "https://noormkdad.com/tools/iso20022-parser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrMkdaddy/iso20022-parser-typescript.git"
  }
}